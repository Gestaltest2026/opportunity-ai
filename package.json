{
  "name": "opportunity-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "extract": "tsx src/extraction/runExtraction.ts",
    "evaluate:applicant-001": "tsx src/extraction/runEvaluation.ts",
    "evaluate:opportunity-001": "tsx src/opportunity/runEvaluation.ts",
    "evaluate:match-001": "tsx src/matching/runMatchEvaluation.ts",
    "evaluate:hash": "tsx src/databank/runHashEvaluation.ts",
    "evaluate:databank-schema": "tsx src/databank/runSchemaEvaluation.ts",
    "evaluate:fixtures": "tsx src/verification/runFixtureValidation.ts",
    "evaluate:domain": "tsx src/verification/runDomainRegression.ts",
    "evaluate:discovery-url-policy": "tsx src/discovery/runUrlPolicyEvaluation.ts",
    "evaluate:discovery-candidates": "tsx src/discovery/runCandidateExtractionEvaluation.ts",
    "evaluate:discovery-classification": "tsx src/discovery/runCandidateClassificationEvaluation.ts",
    "evaluate:opportunity-identity": "tsx src/discovery/runOpportunityIdentityEvaluation.ts",
    "evaluate:change-loop": "tsx src/discovery/runChangeDetectionEvaluation.ts",
    "evaluate:rematch-targets": "tsx src/matching/runRematchTargetEvaluation.ts",
    "evaluate:exception-queue": "tsx src/discovery/runExceptionQueueEvaluation.ts",
    "verify": "tsx src/verification/runOfflineVerification.ts",
    "verify:llm": "npm run evaluate:applicant-001 && npm run evaluate:opportunity-001 && npm run evaluate:match-001",
    "closed-loop": "tsx src/runClosedLoop.ts",
    "databank:upsert": "tsx src/databank/runUpsertOpportunity.ts",
    "databank:rank": "tsx src/matching/runRankDatabank.ts",
    "sources:refresh": "tsx src/discovery/runRefreshSources.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openai": "^5.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
